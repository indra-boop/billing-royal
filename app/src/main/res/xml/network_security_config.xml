<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS wajib di semua build type. Cleartext (HTTP) dilarang, termasuk di release. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
